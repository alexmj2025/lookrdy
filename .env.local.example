# ---------------------------------------------------------------------------
# Lookrdy environment. Copy to .env.local and fill in.
# Everything except NEXT_PUBLIC_* is server-side only and never reaches the
# browser bundle.
# ---------------------------------------------------------------------------

# OpenAI — used for request parsing, outfit composition, and GPT Image
# visualization. Server-side only. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1

# MOCK_AI=1 runs the whole flow deterministically with no OpenAI calls:
# rule-based composition and a generated placeholder visualization. Every
# screen, including hotspots, works. Set to 0 (or remove) once the OpenAI
# account has credits.
MOCK_AI=1

# Supabase — product catalog, sessions, funnel events, generation counts.
# Project settings → API. Without these the app falls back to the local
# JSON catalog and a file-based event log, so it still runs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free generations allowed per anonymous session before the cap message.
FREE_GENERATION_LIMIT=3
