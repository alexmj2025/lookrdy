{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookrdy.example/schemas/simons-products-v2.schema.json",
  "title": "Lookrdy Simons Product Catalog V2",
  "type": "object",
  "required": [
    "catalog_id",
    "schema_version",
    "catalog_version",
    "product_count",
    "catalog_scope",
    "matching_contract",
    "products"
  ],
  "properties": {
    "catalog_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "catalog_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_catalog_version": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "product_count": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_scope": {
      "type": "object"
    },
    "matching_contract": {
      "type": "object"
    },
    "migration_notes": {
      "type": "object"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "schema_version",
          "identity",
          "commerce",
          "classification",
          "variant",
          "media",
          "visual_attributes",
          "matching_profile",
          "data_quality",
          "rights"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^SIM-[0-9]{3}$"
          },
          "schema_version": {
            "const": "2.0.0"
          },
          "identity": {
            "type": "object",
            "required": [
              "retailer",
              "brand",
              "title"
            ]
          },
          "commerce": {
            "type": "object",
            "required": [
              "product_url",
              "currency",
              "regular_price",
              "current_price",
              "sale_status",
              "availability_status",
              "source_checked_at",
              "next_review_at",
              "freshness_status",
              "active_for_pilot"
            ],
            "properties": {
              "product_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www|m)\\.simons\\.ca/"
              },
              "currency": {
                "const": "CAD"
              },
              "regular_price": {
                "type": "number",
                "minimum": 0
              },
              "current_price": {
                "type": "number",
                "minimum": 0
              },
              "active_for_pilot": {
                "type": "boolean"
              }
            }
          },
          "classification": {
            "type": "object",
            "required": [
              "market",
              "department",
              "canonical_category",
              "subcategory",
              "required_slot"
            ]
          },
          "variant": {
            "type": "object",
            "required": [
              "listed_color",
              "selected_color",
              "selected_size",
              "variant_selection_required",
              "attribute_reference_color",
              "color_attributes_are_variant_specific"
            ]
          },
          "media": {
            "type": "object",
            "required": [
              "product_image_url",
              "image_required_for_generation",
              "image_display_authorized",
              "display_mode"
            ]
          },
          "visual_attributes": {
            "type": "object",
            "required": [
              "color",
              "pattern",
              "material",
              "silhouette",
              "construction",
              "styling"
            ]
          },
          "matching_profile": {
            "type": "object",
            "required": [
              "formality_level_1_to_5",
              "warmth_level_1_to_5",
              "season_tags",
              "occasion_tags",
              "look_roles",
              "style_tags",
              "budget_role",
              "match_priority_fields",
              "negative_constraints"
            ]
          },
          "data_quality": {
            "type": "object",
            "required": [
              "commercial_data_confidence",
              "visual_attribute_confidence",
              "verified_fields",
              "inferred_fields",
              "unknown_or_variant_fields",
              "needs_review",
              "review_reasons"
            ]
          },
          "rights": {
            "type": "object",
            "required": [
              "image_use_authorized",
              "affiliate_approved",
              "public_display_allowed",
              "link_out_only"
            ]
          }
        }
      }
    }
  }
}
